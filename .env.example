# Gemini is optional. Leave blank to use the local fallback behavior.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash

# Optional LangSmith tracing.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=multimodal-document-rag

# PDF ingestion and extraction.
DOCLING_ENABLE_OCR=true
DOCLING_TABLE_MODE=FAST
PAGE_IMAGE_SCALE=0.5

# Retrieval reranking.
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATES=30
